# ==== Backend ====
ENVIRONMENT=development
SECRET_KEY=changeme-generate-a-real-secret-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://myface:myface@db:5432/myface
POSTGRES_USER=myface
POSTGRES_PASSWORD=myface
POSTGRES_DB=myface

# Stockage - mode "local" (MinIO) par defaut en dev, "supabase" quand credentials fournis
STORAGE_BACKEND=local

# --- Supabase (a fournir plus tard) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=myface-photos

# --- MinIO / S3-compatible local (dev uniquement) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=myface-photos
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

CORS_ORIGINS=http://localhost:3000

# Compte admin initial (utilise par le script de seed)
INITIAL_ADMIN_EMAIL=admin@myface-events.com
INITIAL_ADMIN_PASSWORD=changeme-strong-password

# --- Reconnaissance faciale (InsightFace / buffalo_l) ---
# GPU d'abord (NVIDIA via Docker Desktop), fallback CPU automatique si indisponible
FACE_RECOGNITION_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
FACE_DETECTION_MIN_CONFIDENCE=0.5
FACE_MATCH_SIMILARITY_THRESHOLD=0.45
FACE_CLUSTER_EPS=0.4
FACE_CLUSTER_MIN_SAMPLES=2

# --- Panier & paiement (Phase 3) ---
CART_SESSION_TTL_HOURS=24

# PAYMENT_PROVIDER=manual tant qu'aucune cle marchand reelle n'est fournie :
# simule le flux de paiement SANS deplacer d'argent, pour tester le parcours
# complet. Valeurs possibles : manual | wave | orange_money | mtn_money | moov_money
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=changeme-webhook-secret
DOWNLOAD_URL_TTL_SECONDS=900

# --- Operateurs Mobile Money (a fournir plus tard) ---
WAVE_API_KEY=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
MTN_MONEY_API_KEY=
MTN_MONEY_SUBSCRIPTION_KEY=
MOOV_MONEY_API_KEY=

# --- SMS Africa's Talking (a fournir plus tard) ---
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

APP_BASE_URL=http://localhost:3000

# ==== Frontend ====
NEXT_PUBLIC_API_URL=http://localhost:8000
# Doit rester synchronise avec PAYMENT_PROVIDER cote backend : n'affiche le
# panneau "simuler le paiement" que si aucun vrai operateur n'est branche.
NEXT_PUBLIC_PAYMENT_PROVIDER=manual
