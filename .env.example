# ==== Backend ====
ENVIRONMENT=development
SECRET_KEY=changeme-generate-a-real-secret-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Postgres. En local (docker-compose "db") ou gere (ex: Neon). Si vous
# utilisez le pooler PgBouncer de Neon, prenez l'endpoint DIRECT (sans
# "-pooler") : le mode transaction du pooler est incompatible avec les
# requetes preparees cote serveur qu'asyncpg utilise par defaut.
DATABASE_URL=postgresql+asyncpg://myface:myface@db:5432/myface
POSTGRES_USER=myface
POSTGRES_PASSWORD=myface
POSTGRES_DB=myface
# Base dediee aux tests automatises : toujours un Postgres local jetable,
# jamais la base de production. Si vide, derive de DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://myface:myface@db:5432/myface_test

# Stockage - "local" (MinIO, S3-compatible) par defaut en dev, "supabase" si credentials fournis
STORAGE_BACKEND=local

# --- Supabase (alternative a S3/R2, optionnel) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=myface-photos

# --- S3-compatible : MinIO en local, ou Cloudflare R2 / AWS S3 en prod ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=myface-photos
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

CORS_ORIGINS=http://localhost:3000

# Compte admin initial (utilise par le script de seed)
INITIAL_ADMIN_EMAIL=admin@myface-events.com
INITIAL_ADMIN_PASSWORD=changeme-strong-password

# --- Reconnaissance faciale (InsightFace / buffalo_l) ---
# GPU d'abord (NVIDIA via Docker Desktop), fallback CPU automatique si indisponible
FACE_RECOGNITION_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
FACE_DETECTION_MIN_CONFIDENCE=0.5
FACE_MATCH_SIMILARITY_THRESHOLD=0.45
FACE_CLUSTER_EPS=0.55
FACE_CLUSTER_MIN_SAMPLES=2

# --- Panier & paiement ---
CART_SESSION_TTL_HOURS=24

# PAYMENT_PROVIDER=manual tant qu'aucune cle marchand reelle n'est branchee
# (aucun operateur Mobile Money n'a d'integration API fonctionnelle a ce
# jour). Ne sert qu'a verifier la signature du webhook generique : toute
# commande passe par un QR code marchand configure par evenement (voir
# /events/{id}/payment-methods) + confirmation manuelle organisateur, ou par
# les especes a la borne.
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=changeme-webhook-secret
DOWNLOAD_URL_TTL_SECONDS=900
# Commande jamais payee annulee automatiquement apres ce delai (minutes).
# Jamais applique a une commande "a confirmer" (le client dit avoir paye).
ORDER_PENDING_TTL_MINUTES=60

# Base Neon : renouvellement des connexions et maintien en eveil (secondes).
# Neon coupe les connexions inactives apres ~5 min. 0 desactive le maintien.
DB_POOL_RECYCLE_SECONDS=240
DB_KEEPALIVE_SECONDS=240

# --- Operateurs Mobile Money (integration API reelle non implementee, voir
# services/payments.py) ---
WAVE_API_KEY=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
MTN_MONEY_API_KEY=
MTN_MONEY_SUBSCRIPTION_KEY=
MOOV_MONEY_API_KEY=

# --- SMS Africa's Talking (confirmation de commande, lien de telechargement) ---
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# --- Notifications push (PWA admin) : cle VAPID, generer une paire unique par
# deploiement avec py-vapid (`python -m py_vapid --gen`) ou le script dans
# docs/DEPLOYMENT.md. Ne jamais regenerer sans effacer les abonnements en
# base (ils deviennent invalides). VAPID_SUBJECT = contact mailto: requis par
# la spec Web Push. ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# --- Dossier surveille (ingestion photo automatique, voir
# services/folder_watcher.py) ---
WATCHED_FOLDER_PATH=/watched
WATCHED_FOLDER_POLL_SECONDS=5.0
WATCHED_FOLDER_HOST_DISPLAY_PATH=watched-photos

# URL publique de l'app (liens SMS, QR de telechargement, lien/QR/affiche
# invite, notifications push). Doit etre l'adresse joignable depuis le
# telephone des invites (tunnel ou nom de domaine), pas localhost.
APP_BASE_URL=http://localhost:3000

# --- Tunnel Cloudflare nomme (adresse publique fixe) ---
# Jeton fourni par Cloudflare > Zero Trust > Networks > Tunnels a la creation
# du tunnel. Secret : ne jamais le commiter ni le partager.
CLOUDFLARE_TUNNEL_TOKEN=

# ==== Frontend ====
# Relatif derriere nginx (recommande) : le meme build fonctionne en local et
# via n'importe quelle URL de tunnel. Figee a la compilation du frontend.
NEXT_PUBLIC_API_URL=/api
# Doit rester synchronise avec PAYMENT_PROVIDER cote backend.
NEXT_PUBLIC_PAYMENT_PROVIDER=manual
# Cle publique VAPID (identique a VAPID_PUBLIC_KEY ci-dessus, exposee au navigateur)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
